# 火山方舟（Volcengine Ark）— 错题截图识别
# ----------------------------------------------------------------------
# 1. 在 https://console.volcengine.com/ark 创建/复制 API Key 填入下面
# 2. 确保你已在控制台「模型广场」开通了 Doubao Seed 1.6 视觉模型
# 3. 把本文件复制成 .env.local 并填好后，重启 npm run dev

ARK_API_KEY=

# 直接使用模型名（推荐）：doubao-seed-1.6-250615
# 也可以填控制台创建的「推理接入点」ID：ep-xxxxxxxx-xxxxx
ARK_MODEL=doubao-seed-1.6-250615

# 通常不用改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
